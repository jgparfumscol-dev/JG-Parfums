DATABASE_URL=postgresql://user:password@localhost:5432/jg_parfums

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

FRONTEND_URL=https://jgparfums.com
BACKEND_URL=https://api.jgparfums.com

# Email transaccional (Resend)
RESEND_API_KEY=
EMAIL_FROM=JG Parfums <pedidos@jgparfums.com.co>

# Wompi
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Chatbot (n8n) — POST /chat/message la reenvía a esta URL, ver
# routes/chat.py. Tiene que ser la URL completa del nodo Webhook del
# workflow (con /webhook/... al final), no solo el dominio de n8n. Sin
# esto configurado, el widget del sitio responde "no pudimos conectar"
# en vez de fallar duro.
N8N_CHAT_WEBHOOK_URL=
N8N_CHAT_WEBHOOK_SECRET=

# Dirección pública de la tienda: con ella se verifican y corrigen los
# enlaces a la tienda que responde el chatbot (ver sanitize_reply_links en
# services/chat_catalog.py). Opcional; por defecto https://jgparfums.com.co
SITE_URL=https://jgparfums.com.co

# Aviso por Telegram cuando un pedido pasa a pagado (services/telegram_service.py).
# Bot creado con @BotFather; TELEGRAM_CHAT_ID es el chat (o grupo) que recibe el
# aviso. Opcionales: si falta cualquiera de las dos no se avisa y solo queda un
# log — nunca afecta al pedido ni al webhook de la pasarela.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
